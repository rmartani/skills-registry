{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://registry.stancatti.dev/schemas/redirects.schema.json",
  "title": "Skills Registry slug redirects",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "redirects"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "kind": { "const": "redirects" },
    "redirects": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["from", "to", "resourceId", "reason"],
        "properties": {
          "from": { "$ref": "#/$defs/slug" },
          "to": { "$ref": "#/$defs/slug" },
          "resourceId": { "$ref": "#/$defs/uuid" },
          "reason": { "type": "string", "minLength": 1, "maxLength": 1000 }
        }
      }
    }
  },
  "$defs": {
    "uuid": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "minLength": 1, "maxLength": 80 }
  }
}
