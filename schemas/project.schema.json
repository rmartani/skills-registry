{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://registry.stancatti.dev/schemas/project.schema.json",
  "title": "Skills Registry project",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "id", "slug", "official"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "kind": { "const": "project" },
    "id": { "$ref": "#/$defs/uuid" },
    "slug": { "$ref": "#/$defs/slug" },
    "official": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "repositoryUrl", "homepageUrl", "maintainer", "defaultBranch"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 160 },
        "repositoryUrl": { "$ref": "#/$defs/httpsUrl" },
        "homepageUrl": { "$ref": "#/$defs/httpsUrl" },
        "maintainer": { "$ref": "#/$defs/maintainer" },
        "defaultBranch": { "type": "string", "pattern": "^[A-Za-z0-9._/-]{1,120}$" }
      }
    }
  },
  "$defs": {
    "uuid": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "minLength": 1, "maxLength": 80 },
    "httpsUrl": { "type": "string", "pattern": "^https://[^\\s]+$", "maxLength": 2048 },
    "maintainer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "url"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 160 },
        "url": { "$ref": "#/$defs/httpsUrl" }
      }
    }
  }
}
